# --- Sight Reading landing: environment variables ---

# Public GitHub Releases / download URL. Inlined at build time and read by BOTH
# the client ("GitHub Releases" link) and the subscribe API, so they never drift.
# Falls back to the placeholder in lib/releases.ts if unset. Set this before launch.
NEXT_PUBLIC_RELEASES_URL="https://github.com/webeleon/sight-reading-guitar-practice/releases/latest"

# OPTIONAL — server-only override for the emailed/returned download link.
# Takes precedence over NEXT_PUBLIC_RELEASES_URL for what the subscribe API hands
# back (e.g. to point the email at a specific build). Usually leave this unset.
# RELEASES_URL="https://github.com/webeleon/sight-reading-guitar-practice/releases/latest"

# OPTIONAL — forward captured emails to an external webhook (Zapier, Make, your own endpoint).
# If set, the subscribe API POSTs { email, source, ts } to this URL.
# SUBSCRIBE_WEBHOOK_URL="https://hooks.example.com/abc123"

# OPTIONAL — Resend audience capture (recommended for production).
# If BOTH are set, captured emails are added to the Resend audience.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
# RESEND_AUDIENCE_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
