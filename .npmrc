# electron-vite@5 peers vite ^5||^6||^7, while vitest@4 and @vitejs/plugin-react@6
# peer-require vite ^8. There is no all-stable version set that satisfies both, so we
# install latest-stable across the board and let npm proceed past the vite peer mismatch.
# electron-vite is not exercised until Milestone 3 (Electron shell); reconcile there
# (e.g. electron-vite 6 once it ships stable, or pin vite 7). See LEARNINGS.md > Scaffold.
legacy-peer-deps=true
